#!/bin/bash
echo "======================================"
echo "    GovTrack AI - Setup & CLI         "
echo "======================================"

if [ ! -d "venv" ]; then
    echo "Creating virtual environment..."
    python3 -m venv venv
fi

source venv/bin/activate
echo "Installing dependencies..."
pip install -r requirements.txt -q

echo "Launching GovTrack CLI..."
python3 govtrack_cli.py "$@"
