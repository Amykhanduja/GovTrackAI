{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "../frontend",
    "distDir": "../frontend",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "GovTrack AI",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "category": "Office",
      "copyright": "GovTrack AI 2026",
      "externalBin": ["bin/govtrack-api"],
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
      "identifier": "com.govtrackai.app",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "wix": {
          "language": "en-US",
          "template": null
        }
      }
    },
    "updater": {
      "active": true,
      "endpoints": ["https://api.github.com/repos/YOUR_GITHUB_USER/govtrack-ai/releases/latest"],
      "dialog": true,
      "pubkey": "PUBLIC_KEY_PLACEHOLDER"
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "GovTrack AI",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "focus": true
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "Starting GovTrack AI...",
        "width": 500,
        "height": 350,
        "resizable": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ]
  },
  "plugins": {
    "window-state": {
      "filename": ".window-state"
    }
  }
}
